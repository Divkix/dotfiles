{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '__HOME__/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
